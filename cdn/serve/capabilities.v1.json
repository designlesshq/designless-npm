{
  "schema": "designless-serve-capabilities/v1",
  "version": "v1",
  "note": "Framework support for the Designless serve integration: which file a project wires a brand into, in what form, and which package to install first when there is one. Covers web projects and native app builds. Served statically at https://cdn.designless.app/serve/capabilities.v1.json and fetched at resolve time, so support for a new framework or a new package version arrives without a client release. A partial, absent or malformed copy of this file falls back to the client's own defaults and never breaks resolution.",
  "frameworks": {
    "html": {
      "id": "html",
      "label": "Plain HTML",
      "aliases": [
        "static",
        "vanilla",
        "plain",
        "none"
      ],
      "surface": "html-head",
      "detect": {
        "dep": [],
        "config": [
          "index.html"
        ]
      },
      "wire": {
        "kind": "html-head",
        "file": "index.html",
        "cssForm": "link-tag",
        "scriptForm": "script-tag",
        "envVar": null,
        "hint": "Add inside <head> of every page"
      }
    },
    "nextjs": {
      "id": "nextjs",
      "label": "Next.js (App Router)",
      "aliases": [
        "next",
        "next.js",
        "app-router",
        "nextjs-app"
      ],
      "surface": "react-component",
      "detect": {
        "dep": [
          "next"
        ],
        "config": [
          "next.config.js",
          "next.config.mjs",
          "next.config.ts"
        ],
        "dir": [
          "app",
          "src/app"
        ]
      },
      "wire": {
        "kind": "next-layout",
        "file": "app/layout.tsx",
        "cssForm": "jsx-link",
        "scriptForm": "next-script",
        "envVar": "NEXT_PUBLIC_DESIGNLESS_BRAND_ID",
        "hint": "app/layout.tsx - App Router"
      }
    },
    "nextjs-pages": {
      "id": "nextjs-pages",
      "label": "Next.js (Pages Router)",
      "aliases": [
        "next-pages",
        "pages-router",
        "next.js-pages"
      ],
      "surface": "react-component",
      "detect": {
        "dep": [
          "next"
        ],
        "config": [
          "next.config.js",
          "next.config.mjs",
          "next.config.ts"
        ],
        "dir": [
          "pages",
          "src/pages"
        ]
      },
      "wire": {
        "kind": "next-document",
        "file": "pages/_document.tsx",
        "cssForm": "next-document-link",
        "scriptForm": "next-script",
        "envVar": "NEXT_PUBLIC_DESIGNLESS_BRAND_ID",
        "hint": "pages/_document.tsx - Pages Router"
      }
    },
    "vite": {
      "id": "vite",
      "label": "Vite",
      "aliases": [
        "vite-react",
        "react",
        "react-vite",
        "vitejs"
      ],
      "surface": "html-head",
      "detect": {
        "dep": [
          "vite",
          "@vitejs/plugin-react"
        ],
        "config": [
          "vite.config.js",
          "vite.config.ts",
          "vite.config.mjs"
        ]
      },
      "wire": {
        "kind": "vite-index",
        "file": "index.html",
        "cssForm": "link-tag",
        "scriptForm": "script-tag",
        "envVar": null,
        "hint": "index.html - Vite serves this verbatim"
      }
    },
    "vue": {
      "id": "vue",
      "label": "Vue (Vite)",
      "aliases": [
        "vuejs",
        "vue3",
        "vue.js"
      ],
      "surface": "html-head",
      "detect": {
        "dep": [
          "vue",
          "@vitejs/plugin-vue"
        ],
        "config": [
          "vite.config.js",
          "vite.config.ts",
          "vite.config.mjs"
        ]
      },
      "wire": {
        "kind": "vite-index",
        "file": "index.html",
        "cssForm": "link-tag",
        "scriptForm": "script-tag",
        "envVar": null,
        "hint": "index.html - Vite serves this verbatim"
      }
    },
    "astro": {
      "id": "astro",
      "label": "Astro",
      "aliases": [
        "astrojs",
        "astro.js"
      ],
      "surface": "astro-frontmatter",
      "detect": {
        "dep": [
          "astro"
        ],
        "config": [
          "astro.config.mjs",
          "astro.config.ts",
          "astro.config.js"
        ],
        "dir": [
          "src"
        ]
      },
      "wire": {
        "kind": "astro-layout",
        "file": "src/layouts/Layout.astro",
        "createIfAbsent": true,
        "cssForm": "astro-link",
        "scriptForm": "astro-script",
        "envVar": "PUBLIC_DESIGNLESS_BRAND_ID",
        "hint": "src/layouts/Layout.astro"
      }
    },
    "sveltekit": {
      "id": "sveltekit",
      "label": "SvelteKit",
      "aliases": [
        "svelte",
        "svelte-kit",
        "svelte.js"
      ],
      "surface": "html-head",
      "detect": {
        "dep": [
          "@sveltejs/kit",
          "svelte"
        ],
        "config": [
          "svelte.config.js",
          "svelte.config.mjs"
        ],
        "dir": [
          "src"
        ]
      },
      "wire": {
        "kind": "sveltekit-shell",
        "file": "src/app.html",
        "cssForm": "link-tag",
        "scriptForm": "script-tag",
        "envVar": null,
        "hint": "src/app.html - SvelteKit shell"
      }
    },
    "nuxt": {
      "id": "nuxt",
      "label": "Nuxt",
      "aliases": [
        "nuxtjs",
        "nuxt.js"
      ],
      "surface": "config-object",
      "detect": {
        "dep": [
          "nuxt"
        ],
        "config": [
          "nuxt.config.ts",
          "nuxt.config.js",
          "nuxt.config.mjs"
        ]
      },
      "wire": {
        "kind": "nuxt-config",
        "file": "nuxt.config.ts",
        "cssForm": "nuxt-link-entry",
        "scriptForm": "nuxt-script-entry",
        "envVar": "NUXT_PUBLIC_DESIGNLESS_BRAND_ID",
        "hint": "nuxt.config.ts"
      }
    },
    "react-native": {
      "id": "react-native",
      "label": "React Native",
      "aliases": [
        "reactnative",
        "rn",
        "react native"
      ],
      "surface": "react-component",
      "native": true,
      "detect": {
        "dep": [
          "react-native"
        ],
        "config": [
          "metro.config.js",
          "app.json"
        ]
      },
      "wire": {
        "kind": "rn-provider",
        "file": "App.tsx",
        "cssForm": "rn-provider",
        "scriptForm": "rn-provider",
        "envVar": null,
        "hint": "App.tsx - wrap the app root",
        "install": {
          "kind": "command",
          "manager": "npm",
          "command": "npm install @designless/react-native"
        },
        "verifyPath": "context.json",
        "needle": "@designless/react-native",
        "runtimeCheck": "in the running app, useBrandTheme() returns a non-null theme once the brand has resolved"
      }
    },
    "expo": {
      "id": "expo",
      "label": "Expo",
      "aliases": [
        "expo-router",
        "expo-go"
      ],
      "surface": "react-component",
      "native": true,
      "detect": {
        "dep": [
          "expo"
        ],
        "config": [
          "app.json",
          "app.config.js",
          "app.config.ts"
        ],
        "dir": [
          "app"
        ]
      },
      "wire": {
        "kind": "rn-provider",
        "file": "app/_layout.tsx",
        "cssForm": "rn-provider",
        "scriptForm": "rn-provider",
        "envVar": "EXPO_PUBLIC_DESIGNLESS_BRAND_ID",
        "hint": "app/_layout.tsx - expo-router root layout",
        "install": {
          "kind": "command",
          "manager": "expo",
          "command": "npx expo install @designless/react-native"
        },
        "verifyPath": "context.json",
        "needle": "@designless/react-native",
        "runtimeCheck": "in the running app, useBrandTheme() returns a non-null theme once the brand has resolved"
      }
    },
    "flutter": {
      "id": "flutter",
      "label": "Flutter",
      "aliases": [
        "dart",
        "flutter-app"
      ],
      "surface": "widget-tree",
      "native": true,
      "detect": {
        "dep": [
          "flutter"
        ],
        "config": [
          "pubspec.yaml"
        ],
        "dir": [
          "lib"
        ]
      },
      "wire": {
        "kind": "flutter-scope",
        "file": "lib/main.dart",
        "cssForm": "flutter-scope",
        "scriptForm": "flutter-scope",
        "envVar": null,
        "hint": "lib/main.dart - wrap the app root",
        "install": {
          "kind": "command",
          "manager": "pub",
          "command": "flutter pub add designless_serve_flutter http"
        },
        "verifyPath": "context.json",
        "needle": "designless_serve_flutter",
        "runtimeCheck": "in the running app, BrandScope.of(context).tokens is non-null once the brand has resolved"
      }
    },
    "ios": {
      "id": "ios",
      "label": "iOS (Swift)",
      "aliases": [
        "swift",
        "swiftui",
        "apple",
        "ios-app"
      ],
      "surface": "swift-app",
      "native": true,
      "detect": {
        "config": [
          "Package.swift",
          "Info.plist"
        ],
        "dir": [
          "Sources"
        ]
      },
      "wire": {
        "kind": "swift-app",
        "file": "App.swift",
        "cssForm": "swift-app",
        "scriptForm": "swift-app",
        "envVar": null,
        "hint": "your @main App struct",
        "install": {
          "kind": "manifest-edit",
          "file": "Package.swift",
          "code": ".package(url: \"https://github.com/designlesshq/designless-swift.git\", from: \"0.1.0\")",
          "hint": "Add to dependencies and add \"DesignlessKit\" to your target, or in an Xcode project with no Package.swift use File > Add Package Dependencies with the same URL"
        },
        "verifyPath": "context.json",
        "needle": "DesignlessKit",
        "runtimeCheck": "in the running app, await brand.tokens is non-nil after initialize() returns"
      }
    },
    "ios-cocoapods": {
      "id": "ios-cocoapods",
      "label": "iOS (CocoaPods)",
      "aliases": [
        "cocoapods",
        "podfile",
        "ios-pods",
        "swift-cocoapods"
      ],
      "surface": "swift-app",
      "native": true,
      "detect": {
        "config": [
          "Podfile"
        ]
      },
      "wire": {
        "kind": "swift-app",
        "file": "App.swift",
        "cssForm": "swift-app",
        "scriptForm": "swift-app",
        "envVar": null,
        "hint": "your @main App struct",
        "install": {
          "kind": "manifest-edit",
          "file": "Podfile",
          "code": "pod 'DesignlessKit', '~> 0.1.0'",
          "hint": "Add inside your app target, then run pod install"
        },
        "verifyPath": "context.json",
        "needle": "DesignlessKit",
        "runtimeCheck": "in the running app, await brand.tokens is non-nil after initialize() returns"
      }
    },
    "android": {
      "id": "android",
      "label": "Android (Kotlin)",
      "aliases": [
        "kotlin",
        "jetpack",
        "compose",
        "android-app"
      ],
      "surface": "application-class",
      "native": true,
      "detect": {
        "config": [
          "build.gradle.kts",
          "build.gradle",
          "settings.gradle.kts"
        ],
        "dir": [
          "app/src/main"
        ]
      },
      "wire": {
        "kind": "kotlin-application",
        "file": "app/src/main/java/MainApplication.kt",
        "cssForm": "kotlin-application",
        "scriptForm": "kotlin-application",
        "envVar": null,
        "hint": "your Application subclass, under the app's own package (create one and name it in AndroidManifest.xml if the project has none)",
        "install": {
          "kind": "manifest-edit",
          "file": "app/build.gradle.kts",
          "code": "implementation(\"io.designless:serve-android:0.1.0\")",
          "hint": "Add inside the dependencies { } block"
        },
        "verifyPath": "context.json",
        "needle": "io.designless.serve.android",
        "runtimeCheck": "in the running app, brand.tokens is non-null after initialize() returns"
      }
    }
  }
}
